    <pous>
      <pou name="TimeManager" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="hTask">
              <type>
                <derived name="CmpIecTask.RTS_IEC_HANDLE" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Дескриптор (handle) задачи *)</xhtml>
              </documentation>
            </variable>
            <variable name="result">
              <type>
                <derived name="CmpIecTask.RTS_IEC_RESULT" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Результат выполнения функций *)</xhtml>
              </documentation>
            </variable>
            <variable name="pCurrentTaskInfo">
              <type>
                <pointer>
                  <baseType>
                    <derived name="CmpIecTask.Task_Info2" />
                  </baseType>
                </pointer>
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Указатель на структуру с информацией о задаче *)</xhtml>
              </documentation>
            </variable>
            <variable name="CurrentTaskInfo">
              <type>
                <derived name="CmpIecTask.Task_Info2" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Сама структура с данными *)</xhtml>
              </documentation>
            </variable>
            <variable name="DateAndTime">
              <type>
                <derived name="DTU.GetDateAndTime" />
              </type>
            </variable>
            <variable name="_dateAndTime">
              <type>
                <DT />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">
// 1. Получаем дескриптор текущей задачи
hTask := CmpIecTask.IecTaskGetCurrent(pResult := ADR(result));

// 2. Если дескриптор получен успешно, запрашиваем информацию о задаче
IF hTask &lt;&gt; 0 THEN
    // IecTaskGetInfo3 возвращает указатель на структуру данных о задаче
    pCurrentTaskInfo := CmpIecTask.IecTaskGetInfo3(hIecTask := hTask, pResult := ADR(result));
    
    // 3. Если указатель действителен, копируем данные в нашу локальную переменную
    IF pCurrentTaskInfo &lt;&gt; 0 THEN
        CurrentTaskInfo := pCurrentTaskInfo^;
    END_IF 
END_IF


DateAndTime(xExecute := TRUE);
	IF DateAndTime.xDone THEN
		_dateAndTime := DateAndTime.dtDateAndTime;
		DateAndTime(xExecute := FALSE);
	END_IF
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="get_cycle_count">
              <interface>
                <returnType>
                  <UDINT />
                </returnType>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">get_cycle_count := DWORD_TO_UDINT(CurrentTaskInfo.dwCycleCount);
</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
        </addData>
