    <pous>
      <pou name="MAIN" pouType="program">
        <interface>
          <localVars>
            <variable name="TimeManagerEx">
              <type>
                <derived name="TimeManager" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Блок с данными о времени</xhtml>
              </documentation>
            </variable>
            <variable name="InputManagerEx">
              <type>
                <derived name="InputManager" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Блок с данными входных сигналов</xhtml>
              </documentation>
            </variable>
            <variable name="StandLogicEx">
              <type>
                <derived name="StandLogic" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Логика управления стэндом</xhtml>
              </documentation>
            </variable>
            <variable name="ServoDriverEx">
              <type>
                <derived name="SM3ServoDriver" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Блок туправления сервоприводом</xhtml>
              </documentation>
            </variable>
            <variable name="PIDControllerEx">
              <type>
                <derived name="BasicPIDController" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Блок пегулятора</xhtml>
              </documentation>
            </variable>
            <variable name="OutputManagerEx">
              <type>
                <derived name="OutputManager" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Блок с данными выходных сигналов</xhtml>
              </documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// Данные задачи
TimeManagerEx();

// Входные данные
InputManagerEx();

// Логика управления стэндом
StandLogicEx(
		TimeManager			:= TimeManagerEx,
		InputManager		:= InputManagerEx,
		PIDController		:= PIDControllerEx,
		ServoDriver			:= ServoDriverEx,
 		OutputManager		:= OutputManagerEx);	
			
// Регулятор		
PIDControllerEx();
	
// Сервопривод	
ServoDriverEx(TimeManager := TimeManagerEx);		
		
// Пишем выходные данные		
OutputManagerEx();


</xhtml>
          </ST>
        </body>
        <addData />
      </pou>
