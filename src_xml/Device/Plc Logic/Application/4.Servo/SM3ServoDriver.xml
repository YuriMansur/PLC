        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// Проверка связи
_CheckAxisCommuniction(
	Axis	:= SM_Drive_GenericDSP402,
	bEnable := TRUE);

//Проверка наличия питания
FOR _pNum := 0 TO 1 DO
	_CheckPowerStatus(
		Axis			:= SM_Drive_GenericDSP402,
		Enable			:= TRUE,
		ParameterNumber	:= dPowerParameter[_pNum],
		Value			=&gt; _powerStatusValue[_pNum]); 
END_FOR

// Питание драйвера
_Power(Axis	:= SM_Drive_GenericDSP402);

// Ручное управление дравером
_Jogging(Axis := SM_Drive_GenericDSP402); 

//Режим управления скоростью
_FollowVelocity(Axis := SM_Drive_GenericDSP402);

// Сброс ошибок
_Reset_Errors(Axis:= SM_Drive_GenericDSP402, Execute:= _reset_Enable); 

// // Запись флагов ошибок ФБ в массив
// _bErrors[communication]	 := _CheckAxisCommuniction.bError;
// _bErrors[power]			 := _Power.Error;
// _bErrors[jogging]		 := _Jogging.Error;
// _bErrors[follow]		 := _FollowVelocity.bError;
// _bErrors[reset]			 := _Reset_Errors.Error;

// Запись ошибок
FOR _errorIndex := communication TO lastIndex - 1 DO
	// Триггеры ошибок для записи в лог	
	_trErrorsTrigs[_errorIndex](CLK := _bErrors[_errorIndex]);
	
	// 	Формирование слова ошибок
    IF _bErrors[_errorIndex] THEN
        _wAxisErrors := _wAxisErrors OR SHL(BYTE#1, _errorIndex);
	ELSE
		_wAxisErrors := _wAxisErrors AND NOT SHL(BYTE#1, _errorIndex);
    END_IF
	
END_FOR

// Идентификаторы ошибок
_eAxisErrorsID	[communication]	:= _CheckAxisCommuniction.eErrorID;
_eAxisErrorsID	[power]			:= _Power.ErrorID;
_eAxisErrorsID	[jogging]		:= _Jogging.ErrorID;
_eAxisErrorsID	[follow]		:= _FollowVelocity.iErrorID;
_eAxisErrorsID	[reset]			:= _Reset_Errors.ErrorID;

//Коментарии к ошибкам
_sComments		[communication] := 'Ошибка при диагностике связи';
_sComments		[power]			:= 'Ошибка при включении питания драйвера';
_sComments		[jogging]		:= 'Ошибка при ручном управлении';
_sComments		[follow]		:= 'Ошибка при управлении скоростью';
_sComments		[reset]			:= 'Ошибка при сбросе ошибок';

// Метод для записи ошибки в лог
FOR _errorIndex := communication TO lastIndex - 1 DO
_error_handler(
	bError		:= _trErrorsTrigs[_errorIndex].Q,
	arrIndex	:= _errorIndex,
	eErrorID	:= _eAxisErrorsID[_errorIndex],
	sComment	:= _sComments[_errorIndex]
);	
END_FOR

_ErrorsFlag	:= _wAxisErrors &gt; 0;




</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="set_power_on">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <inputVars>
                  <variable name="powerState">
                    <type>
                      <BOOL />
                    </type>
                    <initialValue>
                      <simpleValue value="FALSE" />
                    </initialValue>
                  </variable>
                </inputVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">

CASE _powerSteps OF
	0:
		IF powerState THEN
			set_power_on := _Power.Status;
		ELSE
			_powerSteps	:= _powerSteps + 1;	
		END_IF
		
	1: 
		_Power.Enable		:= TRUE;
		_Power.bRegulatorOn := TRUE;
		_Power.bDriveStart	:= TRUE;
		_powerSteps			:= _powerSteps + 1;
	2:
		IF _Power.Status THEN 
			_Power.Enable	:= FALSE;
			_powerSteps		:= _powerSteps + 1;
		END_IF
	3: 
			_Power.bRegulatorOn := FALSE;
			_Power.bDriveStart	:= FALSE;
			set_power_on		:= TRUE;
			_powerSteps			:= 0;
END_CASE
</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
