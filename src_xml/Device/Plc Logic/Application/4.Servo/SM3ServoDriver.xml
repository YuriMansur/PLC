          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="set_power_off">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <inputVars>
                  <variable name="powerState">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                </inputVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">IF powerState THEN
	set_power_off := TRUE;
	RETURN;
ELSE
	CASE _powerSteps OF
		0: 
			_Power.Enable		:= TRUE;
			_Power.bRegulatorOn := FALSE;
			_Power.bDriveStart	:= FALSE;
			_powerSteps			:= _powerSteps + 1;
		1:
			_Power.Enable	:= FALSE;
			_powerSteps			:= _powerSteps + 1;
		2:
			IF NOT _Power.Status THEN
				set_power_off	:= TRUE;
				_powerSteps		:= 0;
			END_IF
	END_CASE
END_IF
</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
