          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="get_power_status">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml"> Проверка питания драйвера</xhtml>
                </documentation>
              </interface>
              <body>
