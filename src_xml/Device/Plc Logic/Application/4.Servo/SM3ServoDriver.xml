          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="_error_handler">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <inputVars>
                  <variable name="bError">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="arrIndex">
                    <type>
                      <derived name="ERROR_INDEX" />
                    </type>
                  </variable>
                  <variable name="eErrorID">
                    <type>
                      <derived name="SMC_ERROR" />
                    </type>
                  </variable>
                  <variable name="sComment">
                    <type>
                      <string />
                    </type>
                  </variable>
                </inputVars>
                <localVars>
                  <variable name="sDT">
                    <type>
                      <string />
                    </type>
                  </variable>
                  <variable name="toStringError">
                    <type>
                      <derived name="SMC_ERROR_TO_STRING" />
                    </type>
                  </variable>
                </localVars>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/accessmodifiers" handleUnknown="implementation">
                    <AccessModifiers Private="true" />
                  </data>
                </addData>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">// Запускаем блок даты и времени
IF bError THEN
// Приводим дату и время к типу STRING
	sDT := (DT_TO_STRING(TimeManager.get_date_time()));
// Проиводим SMC_ERROR к перечислению которое умеет в TO_STRING
	toStringError := TO_WORD(eErrorID);
// Cобираем сообщение	
	_axisErrorsLog[_logSize] := CONCAT(RIGHT(sDT,LEN(sDT)-3),': ');
	_axisErrorsLog[_logSize] := CONCAT(_axisErrorsLog[_logSize], TO_STRING(toStringError));
	_axisErrorsLog[_logSize] := CONCAT(_axisErrorsLog[_logSize],' ,');
	_axisErrorsLog[_logSize] := CONCAT(_axisErrorsLog[_logSize],sComment);
// Двигаем индекс массива	
	IF _logSize &gt;= 9 THEN
		_logSize := 0;
	ELSE	
		_logSize := _logSize + 1;
	END_IF	
END_IF
</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
