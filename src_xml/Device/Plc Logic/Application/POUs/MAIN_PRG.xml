        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">fbInit();
GVL.fbAlarm();

xResetTorque(CLK:= GVL.Control.ResetTorque);
xResetAngle(CLK:= GVL.Control.ResetAngle);
xResetError(CLK:= GVL.Control.ResetError);
xResetAlarm(CLK:= GVL.Control.ResetAlarm);
xWriteRetain(CLK:= GVL.Control.WriteRetain);

IF GVL.Control.CalibrationMode THEN
	;
END_IF

IF GVL.Control.ServiceMode THEN
	;
END_IF

IF xResetTorque.Q THEN
	GVL.iTorque_ADC_offset := GVL.iTorque_RAW;
END_IF

IF xResetAngle.Q THEN
	;
END_IF

IF xWriteRetain.Q THEN
	;
END_IF

wCommand := GetCommand(GVL.Control);

IF GVL.Control.PowerOn THEN
	GVL.fbServo.POWER_ON();
	CASE wCommand OF
		2#000:
			GVL.fbServo.HALT();
		2#001:
			GVL.fbServo.JOG_CW();
		2#010:
			GVL.fbServo.JOG_CCW();
		2#011:
			GVL.fbServo.TORQUE_HOLD();
		2#100:
			GVL.fbServo.MOVE_TO_ANGLE();
		2#101:
			;
		2#110:
			;
	END_CASE
ELSE
	GVL.fbServo.POWER_OFF();
END_IF

GVL.fbServo.RESET_ERROR(xResetError.Q);
//	GVL.fbAlarm.xAlarmReset := TRUE;
</xhtml>
          </ST>
