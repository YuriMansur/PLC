                    </type>
                  </variable>
                </inputVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">fbReset.Execute := Execute;
RESET_ERROR := fbReset.ErrorID;</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
