        <actions>
          <action name="POWER_OFF">
            <body>
              <ST>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">fbPower.bRegulatorOn	:= FALSE;
fbPower.bDriveStart		:= FALSE;

fbJog.JogForward 		:= FALSE;
fbJog.JogBackward		:= FALSE;
fbJog.Velocity			:= 0.0;
</xhtml>
              </ST>
            </body>
            <addData />
          </action>
          <action name="POWER_ON">
            <body>
              <ST>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">fbPower.bRegulatorOn:= TRUE;
fbPower.bDriveStart:= TRUE;</xhtml>
              </ST>
            </body>
            <addData />
          </action>
          <action name="HALT">
            <body>
              <ST>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">fbJog.JogForward		:= FALSE;
fbJog.JogBackward		:= FALSE;
fbJog.Velocity			:= 0.0;

fbFollow.bExecute		:= FALSE;
fbFollow.fSetVelocity	:= 0.0;

fbHalt.Execute			:= TRUE;

xReset := FALSE;
xPIDStart := FALSE;
xJogForward := xJogBackward := FALSE;
xHalt.RESET1 := FALSE;
xHalt.SET := TRUE;
lrSpeed := 0.0;</xhtml>
              </ST>
            </body>
            <addData />
          </action>
          <action name="JOG_CW">
            <body>
              <ST>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">fbHalt.Execute		:= FALSE;
fbJog.JogForward	:= TRUE;
fbJog.JogBackward	:= FALSE;
fbJog.Velocity		:= lrJogVelocity;
</xhtml>
              </ST>
            </body>
            <addData />
          </action>
          <action name="JOG_CCW">
            <body>
              <ST>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">fbHalt.Execute		:= FALSE;
fbJog.JogForward	:= FALSE;
fbJog.JogBackward	:= TRUE;
fbJog.Velocity		:= lrJogVelocity;</xhtml>
              </ST>
            </body>
            <addData />
          </action>
          <action name="TORQUE_HOLD">
            <body>
              <ST>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">fbHalt.Execute			:= FALSE;
fbJog.JogForward		:= FALSE;
fbJog.JogBackward		:= FALSE;
fbJog.Velocity			:= 0.0;

fbFollow.bExecute		:= TRUE;
fbFollow.fSetVelocity	:= GVL.lrFollowVelocity;

</xhtml>
              </ST>
            </body>
            <addData />
          </action>
          <action name="MOVE_TO_ANGLE">
            <body>
              <ST>
                <xhtml xmlns="http://www.w3.org/1999/xhtml" />
              </ST>
            </body>
            <addData />
          </action>
        </actions>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">//
fbPower(Axis:= MainDrive, Enable:= TRUE);
fbStop(Axis:= MainDrive);
fbHalt(Axis:= MainDrive, Deceleration := 1000, Jerk:= 10000);
fbFollow(Axis:= MainDrive);
fbMoveRel(Axis := MainDrive);
fbJog(Axis := MainDrive, Acceleration:= 1000, Deceleration:= 1000, Jerk:= 10000);
fbReset(Axis := MainDrive);

iDriveStatus := MainDrive.nAxisState;
fbActualVelocity(Axis:= MainDrive, Enable:= TRUE);
fbStatus(Axis:= MainDrive, Enable:= TRUE);

lrJogVelocity := TO_LREAL(GVL.iJogVelocity)/10.0;</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
