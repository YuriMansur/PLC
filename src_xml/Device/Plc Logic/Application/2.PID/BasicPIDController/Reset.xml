              </type>
            </variable>
            <variable name="_Status">
              <type>
                <derived name="PID_STATUS_UDT" />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">//Включение ПИД
IF _Status &lt;&gt; Enabled THEN
	Reset();	//Integral := 0; PreviousError := 0;Output := 0;
	RETURN;
ELSE
//Значение текущей ошибки
_Error			:= xError(); //CASE Direction OF DIRECT:xError := (Sp - Pv) * 1.0; REVERSE:xError := (Sp - Pv) * -1.0; END_CASE
// Пропорционал
_Proportional	:= xProportional();	//xProportional := Kp * Error;
// Интеграл
_Integral		:= xIntegral();	//xIntegral := LIMIT(OutMin, (Integral + Ki * Error * ((TIME_TO_REAL (Ts)) / 1000)), OutMax);
// ДиФФеренциал
_Differential	:= xDifferential(); //xDifferential := Kd * (Error - PreviousError) / ((TIME_TO_REAL (Ts)) / 1000);
//Значение предыдущей ошибки
_PreviousError	:= _Error;
//Выход ПИД
_Output := LIMIT(_MinOut, _Proportional + _Integral + _Differential, _MaxOut);
END_IF



</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="Reset">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">_Error			:= 0;
_Integral		:= 0;
_PreviousError	:= 0;
_Output 		:= 0;</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
        </addData>
