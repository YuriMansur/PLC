  <types>
    <dataTypes />
    <pous>
      <pou name="SwitchingWithFeedbackControl" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="xEnable">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
            </variable>
            <variable name="xInputSignal">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
            </variable>
            <variable name="xOutputSignal">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
            </variable>
            <variable name="waitTimeSwitch">
              <type>
                <TIME />
              </type>
              <initialValue>
                <simpleValue value="TIME#2s0ms" />
              </initialValue>
            </variable>
          </inputVars>
          <localVars>
            <variable name="WaitingTimer">
              <type>
                <derived name="WaitingTimer" />
              </type>
            </variable>
          </localVars>
          <outputVars>
            <variable name="xForceOutputSignal">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
            </variable>
            <variable name="xSelfStatus">
              <type>
                <derived name="SW_STATUS" />
              </type>
              <initialValue>
                <simpleValue value="SW_STATUS.NONE" />
              </initialValue>
            </variable>
          </outputVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// Если нет команды — ничего не делаем
IF NOT xEnable THEN
		WaitingTimer(xExecute := FALSE);
		xForceOutputSignal	:= FALSE;
		xSelfStatus			:= SW_STATUS.NONE;
    RETURN;
END_IF

// Если выход ещё не включён — включаем
IF NOT xOutputSignal THEN
    xForceOutputSignal := TRUE;
    RETURN;
END_IF

// Запуск таймера ожидания обратной связи
WaitingTimer(
    xExecute		:= TRUE,
    xCondition		:= xInputSignal,
    tWaitingTime	:= waitTimeSwitch);
	xSelfStatus := SW_STATUS.WAITING;

// Обратная связь получена
IF WaitingTimer.xDone THEN
    WaitingTimer(xExecute := FALSE);
    xSelfStatus	 := SW_STATUS.DONE;

// Таймаут
ELSIF WaitingTimer.xTimeOutError THEN
    WaitingTimer(xExecute := FALSE);
    xSelfStatus	 := SW_STATUS.TIMEOUT_ERROR;

END_IF

</xhtml>
          </ST>
        </body>
        <addData />
      </pou>
    </pous>
