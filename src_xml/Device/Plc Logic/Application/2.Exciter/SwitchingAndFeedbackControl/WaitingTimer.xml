  <types>
    <dataTypes />
    <pous>
      <pou name="WaitingTimer" pouType="functionBlock">
        <interface>
          <inputVars>
            <variable name="xExecute">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Включение работы блока</xhtml>
              </documentation>
            </variable>
            <variable name="xCondition">
              <type>
                <BOOL />
              </type>
              <initialValue>
                <simpleValue value="FALSE" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Ожидаемое состояние</xhtml>
              </documentation>
            </variable>
            <variable name="tWaitingTime">
              <type>
                <TIME />
              </type>
              <initialValue>
                <simpleValue value="TIME#2s0ms" />
              </initialValue>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Максимальное время ожидания состояния</xhtml>
              </documentation>
            </variable>
          </inputVars>
          <outputVars>
            <variable name="xDone">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Флаг успешного ожидания состояния</xhtml>
              </documentation>
            </variable>
            <variable name="xTimeOutError">
              <type>
                <BOOL />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Флаг ошибки, отсутствие успешного выполнения за заданное время ожидания.</xhtml>
              </documentation>
            </variable>
          </outputVars>
          <localVars>
            <variable name="hTask">
              <type>
                <derived name="CmpIecTask.RTS_IEC_HANDLE" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Дескриптор (handle) задачи *)</xhtml>
              </documentation>
            </variable>
            <variable name="result">
              <type>
                <derived name="CmpIecTask.RTS_IEC_RESULT" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Результат выполнения функций *)</xhtml>
              </documentation>
            </variable>
            <variable name="pCurrentTaskInfo">
              <type>
                <pointer>
                  <baseType>
                    <derived name="CmpIecTask.Task_Info2" />
                  </baseType>
                </pointer>
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Указатель на структуру с информацией о задаче *)</xhtml>
              </documentation>
            </variable>
            <variable name="CurrentTaskInfo">
              <type>
                <derived name="CmpIecTask.Task_Info2" />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml">Сама структура с данными *)</xhtml>
              </documentation>
            </variable>
            <variable name="intervalTime">
              <type>
                <TIME />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Время цикла в мс</xhtml>
              </documentation>
            </variable>
            <variable name="accumulatedTime">
              <type>
                <TIME />
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Накопленное время</xhtml>
              </documentation>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// Запись дескриптора текущей задачи в локальную переменную
hTask := CmpIecTask.IecTaskGetCurrent(pResult := ADR(result));

// При успешном получении дискриптора 
IF hTask &lt;&gt; 0 THEN
	// Запрос информации о задаче
    // IecTaskGetInfo3 возвращает указатель на структуру данных о задаче
    pCurrentTaskInfo := CmpIecTask.IecTaskGetInfo3(hIecTask := hTask, pResult := ADR(result));
    // При действительном  указателе, 
    IF pCurrentTaskInfo &lt;&gt; 0 THEN
		// Запись данных в локальную переменную
        CurrentTaskInfo := pCurrentTaskInfo^;
    END_IF 
END_IF

// Записываем полученное время интервала
intervalTime := DWORD_TO_TIME(CurrentTaskInfo.dwInterval / 1000);

//При включении
IF xExecute THEN
	// При отсутвии ошибок
	IF NOT xTimeOutError THEN
		// При наличии требуемого состояния
		IF xCondition AND NOT xTimeOutError THEN 
			// Флаг успешного ожидания
			xDone				:= TRUE;
			// Сброс накопленного времени ожидания
			accumulatedTime		:= T#0MS;
		// При отсутсвии требуемого состояния и отсутствии ошибок
		ELSE
			// Накопление времени ожидания
			accumulatedTime  := accumulatedTime + intervalTime;
			// При достижении максимального времени ожидания
			IF accumulatedTime &gt;= tWaitingTime THEN
				// Флаг ошибки
				xTimeOutError			:= TRUE;
				// Сброс накопленного времени ожидания
				accumulatedTime := T#0MS;
			END_IF
		END_IF
	END_IF
ELSE 
	// Сброс флага успешного ожидания
	xDone				:= FALSE;
	// Сброс флага ошибки
	xTimeOutError		:= FALSE;
	// Сброс накопленного времени ожидания
	accumulatedTime		:= T#0MS;
END_IF
</xhtml>
          </ST>
        </body>
        <addData />
      </pou>
    </pous>
  </types>
