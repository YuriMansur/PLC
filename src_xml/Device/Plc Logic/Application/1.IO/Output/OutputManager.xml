    <pous>
      <pou name="OutputManager" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="OutputBytes">
              <type>
                <array>
                  <dimension lower="0" upper="1" />
                  <baseType>
                    <BYTE />
                  </baseType>
                </array>
              </type>
            </variable>
            <variable name="bitsOutput">
              <type>
                <array>
                  <dimension lower="0" upper="15" />
                  <baseType>
                    <BOOL />
                  </baseType>
                </array>
              </type>
            </variable>
            <variable name="iByte">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="iBit">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="tempByte">
              <type>
                <BYTE />
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">FOR iByte := 0 TO 1 DO
    tempByte := 0;
    FOR iBit := 0 TO 7 DO
        tempByte := tempByte OR (SEL(bitsOutput[iByte*8 + iBit], 0,SHL(BYTE#16#01,iBit)));
    END_FOR
    OutputBytes[iByte] := tempByte;
END_FOR</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="set_data">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <inputVars>
                  <variable name="varName">
                    <type>
                      <derived name="DQ_VARS" />
                    </type>
                  </variable>
                  <variable name="enable">
                    <type>
                      <BOOL />
                    </type>
                    <initialValue>
                      <simpleValue value="FALSE" />
                    </initialValue>
                  </variable>
                </inputVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">bitsOutput[varName]:= enable;
set_data := bitsOutput[varName];</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
