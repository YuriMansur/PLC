                    </type>
                  </variable>
                </inputVars>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">get_discrete_data := bitsInput[varName];</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
