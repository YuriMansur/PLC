    <pous>
      <pou name="InputManager" pouType="functionBlock">
        <interface>
          <localVars>
            <variable name="InputBytes">
              <type>
                <array>
                  <dimension lower="0" upper="1" />
                  <baseType>
                    <BYTE />
                  </baseType>
                </array>
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Физические входы</xhtml>
              </documentation>
            </variable>
            <variable name="bitsInput">
              <type>
                <array>
                  <dimension lower="0" upper="15" />
                  <baseType>
                    <BOOL />
                  </baseType>
                </array>
              </type>
              <documentation>
                <xhtml xmlns="http://www.w3.org/1999/xhtml"> Логический массив битов</xhtml>
              </documentation>
            </variable>
            <variable name="iByte">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="iBit">
              <type>
                <INT />
              </type>
            </variable>
            <variable name="inputReals">
              <type>
                <array>
                  <dimension lower="tenza1000kgSensor" upper="(lastAnalogInIndex - 1)" />
                  <baseType>
                    <REAL />
                  </baseType>
                </array>
              </type>
            </variable>
          </localVars>
        </interface>
        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">FOR iByte := 0 TO 1 DO
    FOR iBit := 0 TO 7 DO
        bitsInput[iByte*8 + iBit] := (InputBytes[iByte] AND SHL(BYTE#16#01, iBit)) &lt;&gt; 0;
    END_FOR
END_FOR</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="get_discrete_data">
              <interface>
                <returnType>
