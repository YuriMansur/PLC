          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="_collect_errors">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <localVars>
                  <variable name="i">
                    <type>
                      <derived name="ERROR_INDEX" />
                    </type>
                  </variable>
                  <variable name="errors">
                    <type>
                      <WORD />
                    </type>
                  </variable>
                </localVars>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/accessmodifiers" handleUnknown="implementation">
                    <AccessModifiers Private="true" />
                  </data>
                </addData>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">

FOR i := communication TO lastIndex - 1 DO
    IF ServoDriver.get_axis_errors(i) THEN
        errors := errors OR SHL(WORD#1, i);
    ELSE
        errors := errors AND NOT SHL(WORD#1, i);
    END_IF
END_FOR

IF errors &gt; 0 THEN
	objectStatus := ERROR;
END_IF</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="_driver_power">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <inOutVars>
                  <variable name="PowerOnCmd">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Команда на включение</xhtml>
                    </documentation>
                  </variable>
                  <variable name="PowerOffCmd">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Команда на отключение</xhtml>
                    </documentation>
                  </variable>
                </inOutVars>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/accessmodifiers" handleUnknown="implementation">
                    <AccessModifiers Private="true" />
                  </data>
                </addData>
                <documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Включение и отключение драйвера</xhtml>
                </documentation>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">// Входные аргументы методов включения и отключения драйвера
// нужны для корретного завершения вызова методов.
// Т.к логика методов работает по шагам,
// на следующих циклах после начала выполнения метода,
// isPowerStatus сигнализирует о включенном питании,
// тем самым заставляя метод прервать выполнение логики

// Включение
IF PowerOnCmd THEN
	IF powerInclusionComplited := ServoDriver.set_power_on(isPowerStatus AND powerInclusionComplited) THEN
		powerInclusionComplited := FALSE;
		PowerOnCmd				:= FALSE;
	END_IF
	// Отключение
ELSIF PowerOffCmd THEN
	IF powerShutdownComplited := ServoDriver.set_power_off(NOT isPowerStatus AND powerShutdownComplited) THEN 
		powerShutdownComplited	:= FALSE;
		PowerOffCmd				:= FALSE;
	END_IF
END_IF</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
