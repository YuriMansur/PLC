doStateRedLightColumn 	 	:= OutputManager.set_data(outRedLightColumn		, doForceRedLightColumn); 	 
doStateGreenLightColumn		:= OutputManager.set_data(outGreenLightColumn	, doForceGreenLightColumn);	 
doStateBuzzerLightColumn	:= OutputManager.set_data(outBuzzerLightColumn	, doForceBuzzerLightColumn);
doStateExciter		   		:= OutputManager.set_data(outExciter			, doForceExciter);		 
