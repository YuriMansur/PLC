          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="_move_algorythm">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <inputVars>
                  <variable name="enable">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                  <variable name="kp">
                    <type>
                      <REAL />
                    </type>
                  </variable>
                  <variable name="ki">
                    <type>
                      <REAL />
                    </type>
                  </variable>
                  <variable name="kd">
                    <type>
                      <REAL />
                    </type>
                  </variable>
                  <variable name="min_out">
                    <type>
                      <REAL />
                    </type>
                  </variable>
                  <variable name="max_out">
                    <type>
                      <REAL />
                    </type>
                  </variable>
                  <variable name="pv">
                    <type>
                      <REAL />
                    </type>
                  </variable>
                  <variable name="sp">
                    <type>
                      <REAL />
                    </type>
                  </variable>
                  <variable name="laststep">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                </inputVars>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/accessmodifiers" handleUnknown="implementation">
                    <AccessModifiers Private="true" />
                  </data>
                </addData>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">IF enable THEN
	PIDController.Set_Configuration(
								Kp		:= kp,
								Ki		:= ki,
								Kd		:= kd,
								MinOut	:= min_out,
								MaxOut	:= max_out,
								Ts		:= TimeManager.get_interval_time_type_TIME(ms),
	);
															
PIDController.Enable();



PIDController.Reset();

PIDController.Get_Diagnostics();



// Управление скоростью
_move_algorythm := ServoDriver.start_follow_velocity(PIDController.xOutput);

ELSE
	PIDController.Disable();
	_move_algorythm := ServoDriver.stop_follow_velocity();
END_IF</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="_get_status">
              <interface>
                <returnType>
                  <derived name="STATUS" />
                </returnType>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/accessmodifiers" handleUnknown="implementation">
                    <AccessModifiers Private="true" />
                  </data>
                </addData>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">IF isError THEN
    _get_status := ERROR;
ELSIF NOT isStateAxisOperational THEN
    _get_status := NOT_COMMUNICATION;
ELSIF NOT isPowerStatus THEN
    _get_status := OFF;
ELSIF isMoving THEN
    _get_status := MOVING;
ELSE
    _get_status := READY;
END_IF
		
</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="_change_control_mode">
              <interface>
                <returnType>
                  <derived name="CONTROL_MODE" />
                </returnType>
                <inOutVars>
                  <variable name="changeMode">
                    <type>
                      <BOOL />
                    </type>
                  </variable>
                </inOutVars>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/accessmodifiers" handleUnknown="implementation">
                    <AccessModifiers Private="true" />
                  </data>
                </addData>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">IF changeMode THEN
	IF isMoving THEN
		changeMode := FALSE;
	ELSE 
		IF (_controlMode = MANUAL) THEN
			_controlMode := AUTO;
			changeMode	:= FALSE;
		ELSIF (_controlMode = AUTO) THEN
			_controlMode := MANUAL;
			changeMode	:= FALSE;
		END_IF
	END_IF
END_IF

_change_control_mode := _controlMode;</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
