        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// Чтение дискретных входов
isInputsReaded			:= _read_inputs();

// Проверка состояния силовозбудителя
isExciterEnabled		:= _check_exciter();

// Проверка состояния снятия с концевиков
isForceRemoveLimitSwitchOn := _check_removing_limit_switch();

// Проверка связи с драйвером
isStateAxisOperational	:= ServoDriver.get_axis_communication();
		
// Проверка наличия питания драйвера
isPowerStatus			:= ServoDriver.get_power_status();

IF NOT isInitialized THEN
	isInitialized := _init(TRUE);
ELSE
	// Включение и отключение дравера
	_driver_power(cmdPowerOn, cmdPowerOff);	
	
	// Режим управления
	CASE read_control_mode OF 
		MANUAL: //Ручное управление
			isMoving := _jogging(
							cmdForward 	 := cmdForwardJogging,
							cmdBackward  := cmdBackwardJogging,
							velocity	 := joggingVelocity,	
			         		acceleration := joggingAcceleration,	
			         		deceleration := joggingDeceleration,
			         		jerk		 := joggingJerk);	
							
		AUTO: // Автоматическое по алгоритму
			;
	END_CASE
	

END_IF
	














 
 IF cc &gt;= 49 THEN
	cc := 0;
ELSE
	cc:= cc + 1;
END_IF

IF val  = 1000 THEN
	qq := TRUE;
	zz := FALSE;
ELSIF val = 0 THEN
	qq := FALSE;
	zz := TRUE;
END_IF

IF qq THEN 
		val := val - 1;
ELSIF zz THEN 
	val := val + 1;
END_IF


tenzaSensorDataArr[cc] := val;
displacementSensorArr[cc] := val + 100.0;
	

	
	//Сброс ошибок
	_reset_alarms(cmdErrorsReset);

	



	

	

	
	
	
	
	
// При аварии колонна подсвечивается красным и включается зуммер
_alarm_notification(FALSE);

// Запись статуса
objectStatus := _get_status();

// Запись выходов
_write_outputs();
</xhtml>
          </ST>
        </body>
