                <documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Поджигает светосигнальную колонну красным </xhtml>
                </documentation>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">IF alarm THEN 
	OutputManager.set_data(varName := outRedLightColumn,	enable := TRUE);
	OutputManager.set_data(varName := outBuzzerLightColumn, enable := TRUE);
ELSE
	OutputManager.set_data(varName := outRedLightColumn,	enable := FALSE);
	OutputManager.set_data(varName := outBuzzerLightColumn, enable := FALSE);
END_IF</xhtml>
                </ST>
