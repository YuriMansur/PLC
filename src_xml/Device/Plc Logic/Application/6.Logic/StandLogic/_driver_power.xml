        <body>
          <ST>
            <xhtml xmlns="http://www.w3.org/1999/xhtml">// Чтение дискретных входов
isInputsReaded			:= _read_inputs();

// Проверка состояния силовозбудителя
isExciterEnabled		:= _check_exciter();

// Проверка состояния снятия с концевиков
isForceRemoveLimitSwitchOn := _check_removing_limit_switch();

// Проверка связи с драйвером
isStateAxisOperational	:= ServoDriver.get_axis_communication();
		
// Проверка наличия питания драйвера
isPowerStatus			:= ServoDriver.get_power_status();

IF NOT isInitialized THEN
	isInitialized := _init(TRUE);
ELSE
	// Включение и отключение дравера
	_driver_power(cmdPowerOn, cmdPowerOff);	
	
	// Режим управления
	CASE read_control_mode OF 
		MANUAL: //Ручное управление
			isMoving := _jogging(
							cmdForward 	 := cmdForwardJogging,
							cmdBackward  := cmdBackwardJogging,
							velocity	 := joggingVelocity,	
			         		acceleration := joggingAcceleration,	
			         		deceleration := joggingDeceleration,
			         		jerk		 := joggingJerk);	
							
		AUTO: // Автоматическое по алгоритму
			;
	END_CASE
	

END_IF
	














 
 IF cc &gt;= 49 THEN
	cc := 0;
ELSE
	cc:= cc + 1;
END_IF

IF val  = 1000 THEN
	qq := TRUE;
	zz := FALSE;
ELSIF val = 0 THEN
	qq := FALSE;
	zz := TRUE;
END_IF

IF qq THEN 
		val := val - 1;
ELSIF zz THEN 
	val := val + 1;
END_IF


tenzaSensorDataArr[cc] := val;
displacementSensorArr[cc] := val + 100.0;
	

	
	//Сброс ошибок
	_reset_alarms(cmdErrorsReset);

	



	

	

	
	
	
	
	
// При аварии колонна подсвечивается красным и включается зуммер
_alarm_notification(FALSE);

// Запись статуса
objectStatus := _get_status();

// Запись выходов
_write_outputs();
</xhtml>
          </ST>
        </body>
        <addData>
          <data name="http://www.3s-software.com/plcopenxml/method" handleUnknown="implementation">
            <Method name="_driver_power">
              <interface>
                <returnType>
                  <BOOL />
                </returnType>
                <inOutVars>
                  <variable name="PowerOnCmd">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Команда на включение</xhtml>
                    </documentation>
                  </variable>
                  <variable name="PowerOffCmd">
                    <type>
                      <BOOL />
                    </type>
                    <documentation>
                      <xhtml xmlns="http://www.w3.org/1999/xhtml"> Команда на отключение</xhtml>
                    </documentation>
                  </variable>
                </inOutVars>
                <addData>
                  <data name="http://www.3s-software.com/plcopenxml/accessmodifiers" handleUnknown="implementation">
                    <AccessModifiers Private="true" />
                  </data>
                </addData>
                <documentation>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">Включение и отключение драйвера</xhtml>
                </documentation>
              </interface>
              <body>
                <ST>
                  <xhtml xmlns="http://www.w3.org/1999/xhtml">// Входные аргументы методов включения и отключения драйвера
// нужны для корретного завершения вызова методов.
// Т.к логика методов работает по шагам,
// на следующих циклах после начала выполнения метода,
// isPowerStatus сигнализирует о включенном питании,
// тем самым заставляя метод прервать выполнение логики

// Включение
IF PowerOnCmd THEN
	IF powerInclusionComplited := ServoDriver.set_power_on(isPowerStatus AND powerInclusionComplited) THEN
		powerInclusionComplited := FALSE;
		PowerOnCmd				:= FALSE;
	END_IF
	// Отключение
ELSIF PowerOffCmd THEN
	IF powerShutdownComplited := ServoDriver.set_power_off(NOT isPowerStatus AND powerShutdownComplited) THEN 
		powerShutdownComplited	:= FALSE;
		PowerOffCmd				:= FALSE;
	END_IF
END_IF</xhtml>
                </ST>
              </body>
              <addData />
            </Method>
          </data>
        </addData>
